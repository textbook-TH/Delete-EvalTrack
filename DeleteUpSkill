<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UpSkillPulse - ระบบคลังความรู้ออนไลน์เพื่อพัฒนาทักษะ</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts: Prompt -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <style>
        * { font-family: 'Prompt', sans-serif; }
        .bg-catalog-gradient {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #020617 100%);
        }
        .shadow-catalog {
            box-shadow: 0 10px 25px -5px rgba(30, 58, 138, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }
        /* Popup Animation Styles */
        .modal-backdrop {
            transition: opacity 0.25s ease-in-out, visibility 0.25s ease-in-out;
        }
        .modal-card {
            transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease-in-out;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- TOP NAVIGATION BAR -->
    <header class="sticky top-0 z-40 bg-slate-900 text-white shadow-md border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 rounded-xl bg-black border border-slate-800 flex items-center justify-center p-1.5 shadow-inner overflow-hidden">
                    <img src="https://raw.githubusercontent.com/textbook-TH/Delete-User/main/logo.png" alt="Logo" class="w-full h-full object-contain">
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <span class="text-xl sm:text-2xl font-bold tracking-wide text-amber-200">UpSkillPulse</span>
                    </div>
                    <p class="text-xs text-blue-200/80 tracking-wider">ระบบคลังความรู้ออนไลน์เพื่อพัฒนาทักษะ</p>
                </div>
            </div>

            <nav class="flex items-center space-x-3">
                <button id="navLogoutBtn" onclick="handleLogout()" class="hidden px-3 py-1.5 sm:px-3.5 sm:py-1.5 rounded-full text-xs sm:text-sm border border-slate-700 hover:border-red-500 hover:bg-red-500/10 text-slate-300 hover:text-red-300 transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-power-off"></i>
                    <span class="hidden sm:inline">ออกจากระบบ</span>
                </button>
            </nav>
        </div>
    </header>

    <main class="flex-grow">
        <!-- SCREEN 1: LOGIN & RESEND VERIFICATION GATE -->
        <section id="loginGateSection" class="max-w-md mx-auto px-4 py-12">
            <div class="bg-white rounded-2xl shadow-catalog border border-slate-200 overflow-hidden">
                <div class="bg-catalog-gradient p-6 text-white text-center">
                    <div class="w-14 h-14 bg-black border border-slate-800 rounded-full mx-auto flex items-center justify-center p-2 mb-3 shadow-inner overflow-hidden">
                        <img src="https://raw.githubusercontent.com/textbook-TH/Delete-User/main/logo.png" alt="Logo" class="w-full h-full object-contain">
                    </div>
                    <h2 class="text-xl font-bold">เข้าสู่ระบบ</h2>
                    <p class="text-xs text-blue-100/80 mt-1">กรอกอีเมลและรหัสผ่านเพื่อเข้าใช้งาน</p>
                </div>

                <form onsubmit="handleLoginSubmit(event)" class="p-6 space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">อีเมลผู้ใช้งาน</label>
                        <div class="relative">
                            <i class="fa-solid fa-envelope absolute left-3 top-3 text-slate-400 text-sm"></i>
                            <input type="email" id="adminEmail" required oninvalid="this.setCustomValidity('กรุณากรอกข้อมูล')" oninput="this.setCustomValidity('')" placeholder="User@kmitl.ac.th" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-slate-700 mb-1">รหัสผ่าน</label>
                        <div class="relative">
                            <i class="fa-solid fa-key absolute left-3 top-3 text-slate-400 text-sm"></i>
                            <input type="password" id="adminPassword" required oninvalid="this.setCustomValidity('กรุณากรอกข้อมูล')" oninput="this.setCustomValidity('')" placeholder="••••••••" class="w-full pl-9 pr-10 py-2.5 rounded-xl border border-slate-300 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                        </div>
                    </div>

                    <button type="submit" class="w-full py-3 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-semibold text-sm shadow-md transition flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        <span>เข้าสู่ระบบ</span>
                    </button>

                    <!-- Resend Email Verification Option -->
                    <div id="resendBlock" class="hidden pt-3 border-t border-slate-200 text-center">
                        <p class="text-xs text-amber-700 font-medium mb-2">ยังไม่ได้รับอีเมลยืนยัน หรือติดสถานะรอการยืนยัน?</p>
                        <button type="button" onclick="resendConfirmationEmail()" class="w-full py-2 px-3 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-300 text-xs font-semibold transition">
                            <i class="fa-solid fa-paper-plane mr-1"></i> กดส่งอีเมลยืนยันอีกครั้ง
                        </button>
                    </div>
                </form>
            </div>
        </section>

        <!-- SCREEN 2: USER MANAGEMENT DASHBOARD -->
        <section id="adminDashboardSection" class="hidden max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="bg-white rounded-2xl p-6 shadow-catalog border border-slate-100 mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-slate-800">รายชื่อสมาชิกทั้งหมด</h1>
                </div>
                <div class="flex items-center space-x-2 w-full sm:w-auto">
                    <div class="relative flex-grow sm:w-64">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400 text-xs"></i>
                        <input type="text" id="userSearchInput" oninput="filterUsers()" placeholder="ค้นหาชื่อ หรืออีเมล..." class="w-full pl-8 pr-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>
                    <button onclick="fetchUsersData()" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition flex items-center space-x-1">
                        <i class="fa-solid fa-arrows-rotate"></i>
                        <span class="hidden sm:inline">รีเฟรช</span>
                    </button>
                </div>
            </div>

            <!-- Users Table -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-100/80 text-slate-700 text-xs uppercase tracking-wider border-b border-slate-200">
                                <th class="py-3.5 px-4 font-semibold hidden sm:table-cell">ชื่อ-นามสกุล</th>
                                <th class="py-3.5 px-4 font-semibold">อีเมลสถาบัน</th>
                                <th class="py-3.5 px-4 font-semibold text-center">
                                    <span class="hidden sm:inline">สิทธิ์ปัจจุบัน</span>
                                    <i class="fa-solid fa-id-badge sm:hidden text-slate-600 text-sm" title="สิทธิ์ปัจจุบัน"></i>
                                </th>
                                <th class="py-3.5 px-4 font-semibold text-center">
                                    <span class="hidden sm:inline">การจัดการ</span>
                                    <i class="fa-solid fa-sliders sm:hidden text-slate-600 text-sm" title="การจัดการ"></i>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="usersTableBody" class="divide-y divide-slate-100 text-sm"></tbody>
                    </table>
                </div>

                <!-- PAGINATION CONTAINER -->
                <div id="paginationContainer" class="px-4 py-3.5 bg-slate-50 border-t border-slate-200 flex items-center justify-between text-xs text-slate-600">
                    <div id="paginationInfo">แสดง 0 รายการ</div>
                    <div id="paginationButtons" class="flex items-center space-x-1"></div>
                </div>
            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer class="bg-slate-900 text-slate-400 py-6 border-t border-slate-800 text-center text-xs">
        <div class="px-4">
            <p>
                <span class="block sm:inline">© 2026 งานเทคโนโลยีการศึกษา คณะวิศวกรรมศาสตร์</span>
                <span class="block sm:inline">สถาบันเทคโนโลยีพระจอมเกล้าเจ้าคุณทหารลาดกระบัง</span>
            </p>
        </div>
    </footer>

    <!-- ELEGANT POPUP MODAL (CENTERED & STYLED) -->
    <div id="customModal" class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm opacity-0 pointer-events-none">
        <div id="modalContent" class="modal-card bg-white rounded-3xl shadow-2xl border border-slate-100 max-w-sm w-full p-6 text-center transform scale-95 opacity-0">
            
            <!-- Icon Container with Glow Ring -->
            <div id="modalIconContainer" class="w-16 h-16 rounded-2xl mx-auto flex items-center justify-center mb-4 transition-all duration-300">
                <i id="modalIcon" class="text-3xl"></i>
            </div>

            <!-- Title & Message -->
            <h3 id="modalTitle" class="text-lg font-bold text-slate-800 mb-2 tracking-tight"></h3>
            <p id="modalMessage" class="text-sm text-slate-600 mb-6 leading-relaxed font-normal"></p>

            <!-- Modal Action Buttons -->
            <div id="modalActions" class="flex items-center justify-center space-x-3">
                <button id="modalPrimaryBtn" class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 active:scale-95 text-white font-semibold text-xs shadow-md transition-all duration-150">
                    ตกลง
                </button>
            </div>
        </div>
    </div>

    <script>
        const SUPABASE_URL = "https://soveyqvggppjklddrwja.supabase.co";
        const SUPABASE_KEY = "sb_publishable_OuBKjdxDFH7PiHpXMT2XkA_qh2pzRGq";
        let supabaseClient = null;

        try {
            if (typeof supabase !== 'undefined' && supabase.createClient) {
                supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
            }
        } catch (e) {
            console.error("Supabase Client Init Error:", e);
        }

        let currentAdminUser = null;
        let allUsersList = [];
        let filteredUsersList = [];
        let currentPage = 1;
        const pageSize = 20;

        window.addEventListener('DOMContentLoaded', async () => {
            await checkAdminSession();
        });

        async function checkIsUserAdmin(userId) {
            if (!supabaseClient || !userId) return false;
            try {
                const { data, error } = await supabaseClient
                    .from('elearning_users')
                    .select('role, is_admin')
                    .eq('id', userId)
                    .maybeSingle();

                if (!error && data) {
                    return data.role === 'admin' || data.is_admin === true;
                }
            } catch (err) {
                console.warn("User role check warning:", err);
            }
            return false;
        }

        async function checkAdminSession() {
            if (!supabaseClient) return;
            const { data: { session } } = await supabaseClient.auth.getSession();
            
            if (session && session.user) {
                const isAdmin = await checkIsUserAdmin(session.user.id);
                if (isAdmin) {
                    currentAdminUser = session.user;
                    showDashboard();
                    await fetchUsersData();
                    return;
                }
            }
            showLoginGate();
        }

        async function handleLoginSubmit(e) {
            e.preventDefault();
            const email = document.getElementById('adminEmail').value.trim();
            const password = document.getElementById('adminPassword').value;

            if (!supabaseClient) return;

            try {
                const { data, error } = await supabaseClient.auth.signInWithPassword({ email, password });
                
                if (error) {
                    if (error.message.includes("Email not confirmed")) {
                        document.getElementById('resendBlock').classList.remove('hidden');
                        showPopup("แจ้งเตือน", "บัญชีนี้ยังไม่ได้ยืนยันอีเมล! กรุณากดส่งอีเมลยืนยันด้านล่าง", "warning");
                        return;
                    }
                    throw error;
                }

                if (data.user) {
                    const isAdmin = await checkIsUserAdmin(data.user.id);

                    if (isAdmin) {
                        currentAdminUser = data.user;
                        showPopup("เข้าสู่ระบบสำเร็จ", `ยินดีต้อนรับ ${data.user.email}`, "success");
                        showDashboard();
                        await fetchUsersData();
                    } else {
                        await supabaseClient.auth.signOut();
                        showPopup("สิทธิ์ไม่ถูกต้อง", "บัญชีนี้ไม่มีสิทธิ์เข้าใช้งานระบบผู้ดูแล", "error");
                    }
                }
            } catch (err) {
                showPopup("เข้าสู่ระบบไม่สำเร็จ", err.message || "อีเมลหรือรหัสผ่านไม่ถูกต้อง", "error");
            }
        }

        async function resendConfirmationEmail() {
            const email = document.getElementById('adminEmail').value.trim();
            if (!email) {
                showPopup("แจ้งเตือน", "กรุณากรอกอีเมลก่อนกดส่ง", "warning");
                return;
            }

            try {
                const { error } = await supabaseClient.auth.resend({
                    type: 'signup',
                    email: email,
                });
                if (error) throw error;
                showPopup("สำเร็จ", `ระบบส่งลิงก์ยืนยันไปยัง ${email} เรียบร้อยแล้ว!`, "success");
            } catch (err) {
                showPopup("เกิดข้อผิดพลาด", "ไม่สามารถส่งอีเมลได้: " + err.message, "error");
            }
        }

        async function fetchUsersData() {
            if (!supabaseClient) return;
            try {
                const { data, error } = await supabaseClient
                    .from('elearning_users')
                    .select('*')
                    .order('created_at', { ascending: false });

                if (!error && data) {
                    allUsersList = data;
                    filteredUsersList = [...allUsersList];
                    currentPage = 1;
                    renderPaginatedUsers();
                } else if (error) {
                    showPopup("ข้อผิดพลาด", "ไม่สามารถดึงข้อมูลสมาชิกได้: " + error.message, "error");
                }
            } catch (e) {
                console.error("Fetch users error:", e);
            }
        }

        function renderPaginatedUsers() {
            const totalUsers = filteredUsersList.length;
            const totalPages = Math.ceil(totalUsers / pageSize) || 1;

            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const startIndex = (currentPage - 1) * pageSize;
            const endIndex = Math.min(startIndex + pageSize, totalUsers);
            const paginatedData = filteredUsersList.slice(startIndex, endIndex);

            renderUsersTable(paginatedData);
            renderPaginationControls(totalUsers, totalPages, startIndex, endIndex);
        }

        function renderUsersTable(list) {
            const tbody = document.getElementById('usersTableBody');
            tbody.innerHTML = '';

            if (list.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="py-8 text-center text-slate-400">ไม่พบรายชื่อสมาชิกในระบบ</td></tr>`;
                return;
            }

            list.forEach(u => {
                const isStaffOrAdmin = u.role === 'admin' || u.is_admin === true;
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition border-b border-slate-100";

                tr.innerHTML = `
                    <td class="py-3.5 px-4 font-semibold text-slate-800 hidden sm:table-cell">
                        ${u.full_name || 'ไม่ระบุชื่อ'}
                    </td>
                    <td class="py-3.5 px-4 text-slate-600 font-mono text-xs">
                        ${u.email}
                    </td>
                    <td class="py-3.5 px-4 text-center">
                        <!-- Desktop View -->
                        <span class="hidden sm:inline-block">
                            ${isStaffOrAdmin ? 
                                '<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-700 border border-rose-200"><i class="fa-solid fa-user-gear mr-1"></i> เจ้าหน้าที่/Admin</span>' : 
                                '<span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200"><i class="fa-solid fa-users mr-1"></i> สมาชิก</span>'
                            }
                        </span>
                        <!-- Mobile View (Icon Only) -->
                        <span class="sm:hidden inline-block" title="${isStaffOrAdmin ? 'เจ้าหน้าที่/Admin' : 'สมาชิก'}">
                            ${isStaffOrAdmin ? 
                                '<i class="fa-solid fa-user-gear text-rose-600 text-base"></i>' : 
                                '<i class="fa-solid fa-user text-amber-600 text-base"></i>'
                            }
                        </span>
                    </td>
                    <td class="py-3.5 px-4 text-center">
                        <button onclick="confirmDeleteUser('${u.id}', '${u.full_name || u.email}')" class="px-2.5 py-1.5 sm:px-3.5 sm:py-1.5 rounded-lg border border-red-200 bg-red-50 hover:bg-red-100 text-red-600 hover:text-red-700 text-xs font-semibold transition inline-flex items-center space-x-1 shadow-sm active:scale-95" title="ลบสมาชิก">
                            <i class="fa-solid fa-trash-can"></i>
                            <span class="hidden sm:inline">ลบสมาชิก</span>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function renderPaginationControls(totalUsers, totalPages, startIndex, endIndex) {
            const infoText = document.getElementById('paginationInfo');
            const btnContainer = document.getElementById('paginationButtons');

            if (totalUsers === 0) {
                infoText.textContent = "แสดง 0 รายการ";
                btnContainer.innerHTML = '';
                return;
            }

            infoText.textContent = `แสดง ${startIndex + 1} - ${endIndex} จากทั้งหมด ${totalUsers} รายการ`;
            btnContainer.innerHTML = '';

            const prevBtn = document.createElement('button');
            prevBtn.className = `px-2.5 py-1 rounded-md text-xs font-medium border ${currentPage === 1 ? 'opacity-50 cursor-not-allowed bg-slate-100 text-slate-400' : 'bg-white hover:bg-slate-100 text-slate-700 border-slate-300'}`;
            prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left"></i>';
            prevBtn.disabled = currentPage === 1;
            prevBtn.onclick = () => { currentPage--; renderPaginatedUsers(); };
            btnContainer.appendChild(prevBtn);

            for (let i = 1; i <= totalPages; i++) {
                const pBtn = document.createElement('button');
                pBtn.className = `px-3 py-1 rounded-md text-xs font-semibold border ${i === currentPage ? 'bg-amber-600 text-white border-amber-600' : 'bg-white hover:bg-slate-100 text-slate-700 border-slate-300'}`;
                pBtn.textContent = i;
                pBtn.onclick = () => { currentPage = i; renderPaginatedUsers(); };
                btnContainer.appendChild(pBtn);
            }

            const nextBtn = document.createElement('button');
            nextBtn.className = `px-2.5 py-1 rounded-md text-xs font-medium border ${currentPage === totalPages ? 'opacity-50 cursor-not-allowed bg-slate-100 text-slate-400' : 'bg-white hover:bg-slate-100 text-slate-700 border-slate-300'}`;
            nextBtn.innerHTML = '<i class="fa-solid fa-chevron-right"></i>';
            nextBtn.disabled = currentPage === totalPages;
            nextBtn.onclick = () => { currentPage++; renderPaginatedUsers(); };
            btnContainer.appendChild(nextBtn);
        }

        function confirmDeleteUser(userId, userName) {
            if (currentAdminUser && currentAdminUser.id === userId) {
                showPopup("ไม่สามารถดำเนินการได้", "ไม่สามารถลบบัญชีผู้ใช้ที่กำลังใช้งานอยู่ได้", "error");
                return;
            }

            // Updated confirm deletion message as explicitly requested
            showConfirmPopup("ยืนยันการลบสมาชิก", "คุณแน่ใจหรือไม่ว่าต้องการลบสมาชิก", async () => {
                try {
                    const { error } = await supabaseClient
                        .from('elearning_users')
                        .delete()
                        .eq('id', userId);

                    if (error) throw error;

                    showPopup("สำเร็จ", `ลบสมาชิกเรียบร้อยแล้ว`, "success");
                    await fetchUsersData();
                } catch (err) {
                    showPopup("เกิดข้อผิดพลาด", "เกิดข้อผิดพลาดในการลบสมาชิก: " + err.message, "error");
                }
            });
        }

        function filterUsers() {
            const query = document.getElementById('userSearchInput').value.trim().toLowerCase();
            filteredUsersList = allUsersList.filter(u => 
                (u.full_name && u.full_name.toLowerCase().includes(query)) ||
                (u.email && u.email.toLowerCase().includes(query))
            );
            currentPage = 1;
            renderPaginatedUsers();
        }

        async function handleLogout() {
            if (supabaseClient) await supabaseClient.auth.signOut();
            currentAdminUser = null;
            showLoginGate();
        }

        function showLoginGate() {
            document.getElementById('loginGateSection').classList.remove('hidden');
            document.getElementById('adminDashboardSection').classList.add('hidden');
            document.getElementById('navLogoutBtn').classList.add('hidden');
        }

        function showDashboard() {
            document.getElementById('loginGateSection').classList.add('hidden');
            document.getElementById('adminDashboardSection').classList.remove('hidden');
            document.getElementById('navLogoutBtn').classList.remove('hidden');
        }

        /* POPUP MODAL SYSTEM - ENHANCED & CENTERED */
        function showPopup(title, message, type = 'info') {
            const modal = document.getElementById('customModal');
            const content = document.getElementById('modalContent');
            const iconBg = document.getElementById('modalIconContainer');
            const icon = document.getElementById('modalIcon');
            const titleEl = document.getElementById('modalTitle');
            const messageEl = document.getElementById('modalMessage');
            const actionsEl = document.getElementById('modalActions');

            titleEl.textContent = title;
            messageEl.innerHTML = message;

            if (type === 'success') {
                iconBg.className = 'w-16 h-16 rounded-2xl mx-auto flex items-center justify-center mb-4 bg-emerald-50 text-emerald-500 ring-8 ring-emerald-500/10 shadow-sm';
                icon.className = 'fa-solid fa-circle-check text-3xl';
            } else if (type === 'error') {
                iconBg.className = 'w-16 h-16 rounded-2xl mx-auto flex items-center justify-center mb-4 bg-rose-50 text-rose-500 ring-8 ring-rose-500/10 shadow-sm';
                icon.className = 'fa-solid fa-circle-xmark text-3xl';
            } else if (type === 'warning') {
                iconBg.className = 'w-16 h-16 rounded-2xl mx-auto flex items-center justify-center mb-4 bg-amber-50 text-amber-500 ring-8 ring-amber-500/10 shadow-sm';
                icon.className = 'fa-solid fa-triangle-exclamation text-3xl';
            } else {
                iconBg.className = 'w-16 h-16 rounded-2xl mx-auto flex items-center justify-center mb-4 bg-slate-100 text-slate-600 ring-8 ring-slate-400/10 shadow-sm';
                icon.className = 'fa-solid fa-circle-info text-3xl';
            }

            actionsEl.innerHTML = `
                <button onclick="closePopup()" class="w-full py-2.5 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 active:scale-95 text-white font-semibold text-xs shadow-md transition-all duration-150">
                    ตกลง
                </button>
            `;

            modal.classList.remove('opacity-0', 'pointer-events-none');
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }

        function showConfirmPopup(title, message, onConfirm) {
            const modal = document.getElementById('customModal');
            const content = document.getElementById('modalContent');
            const iconBg = document.getElementById('modalIconContainer');
            const icon = document.getElementById('modalIcon');
            const titleEl = document.getElementById('modalTitle');
            const messageEl = document.getElementById('modalMessage');
            const actionsEl = document.getElementById('modalActions');

            titleEl.textContent = title;
            messageEl.innerHTML = message;

            iconBg.className = 'w-16 h-16 rounded-2xl mx-auto flex items-center justify-center mb-4 bg-red-50 text-red-500 ring-8 ring-red-500/10 shadow-sm';
            icon.className = 'fa-solid fa-trash-can text-3xl';

            actionsEl.innerHTML = `
                <button id="cancelModalBtn" onclick="closePopup()" class="w-full py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 font-semibold text-xs transition-all duration-150">
                    ยกเลิก
                </button>
                <button id="confirmModalBtn" class="w-full py-2.5 px-4 rounded-xl bg-red-600 hover:bg-red-700 active:scale-95 text-white font-semibold text-xs shadow-md shadow-red-500/20 transition-all duration-150">
                    ยืนยันการลบ
                </button>
            `;

            document.getElementById('confirmModalBtn').onclick = async () => {
                closePopup();
                if (onConfirm) await onConfirm();
            };

            modal.classList.remove('opacity-0', 'pointer-events-none');
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
        }

        function closePopup() {
            const modal = document.getElementById('customModal');
            const content = document.getElementById('modalContent');

            content.classList.remove('scale-100', 'opacity-100');
            content.classList.add('scale-95', 'opacity-0');

            setTimeout(() => {
                modal.classList.add('opacity-0', 'pointer-events-none');
            }, 150);
        }
    </script>
</body>
</html>
